# ==============================================================================
# Multi-Source Agentic Text-to-SQL with MCP - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Local / Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# PostgreSQL Configuration (Sales / Transactions Domain - Read-Only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_db
POSTGRES_USER=readonly_pg_user
POSTGRES_PASSWORD=readonly_password

# SQL Server Configuration (CRM / Complaints Domain - Read-Only)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=crm_db
SQLSERVER_USER=readonly_mssql_user
SQLSERVER_PASSWORD=readonly_password
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# DuckDB / Local File Storage Configuration (Products & Inventory Domain)
DUCKDB_DATABASE_PATH=:memory:
DATA_FILES_DIR=data/files

# Custom MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
MCP_QUERY_TIMEOUT_SECONDS=5
MCP_MAX_RESULT_ROWS=200

# FastAPI Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
